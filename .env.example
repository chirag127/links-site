# links.oriz.in — public build-time env (Astro import.meta.env; PUBLIC_ prefix exposed to client)
# Clerk — cross-subdomain SSO across *.oriz.in; gates ONLY personal features (field notebook). Public content never gated.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Firebase — Firestore ONLY (auth is Clerk). Keyed by Clerk user id. Small per-user data (saved specimens).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
