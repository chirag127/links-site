---
import Wordmark from '../components/Wordmark.astro'
import Footer from '../components/Footer.astro'
import ClerkIsland from '../components/ClerkIsland.tsx'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'The Field Ledger — 111 curated 2026 developer sites, pressed, classified, and verified alive.',
} = Astro.props

const fonts =
  'https://fonts.bunny.net/css?family=dm-serif-display:400,400i|spectral:400,400i,600|space-mono:400,700'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      const t = localStorage.getItem('theme')
      if (t) document.documentElement.setAttribute('data-theme', t)
    </script>
  </head>
  <body>
    <header class="site-header">
      <Wordmark />
      <div class="header-tools">
        <a class="icon-btn" href="/feed.xml" aria-label="RSS field dispatch" title="RSS">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        </a>
        <button class="search-btn" type="button" onclick="document.getElementById('search-dialog')?.showModal()">
          Search <kbd>⌘K</kbd>
        </button>
        <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle day / herbarium-night">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <ClerkIsland client:only="react" />
      </div>
    </header>

    <slot />

    <Footer />

    <dialog id="search-dialog" aria-label="Search specimens">
      <form method="dialog" style="padding:1.4rem;">
        <input id="search-input" type="search" placeholder="Search 111 specimens by name, habitat, field note…" autofocus />
        <div id="search-results"></div>
      </form>
    </dialog>

    <script>
      // theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme')
        const next = cur === 'dark' ? 'light' : 'dark'
        document.documentElement.setAttribute('data-theme', next)
        localStorage.setItem('theme', next)
      })

      // search dialog + keyboard
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault()
          ;(document.getElementById('search-dialog') as HTMLDialogElement | null)?.showModal()
        }
        if (e.key === 'Escape') (document.getElementById('search-dialog') as HTMLDialogElement | null)?.close()
      })

      let idx: any = null
      let docs: any[] = []
      async function ensureIndex() {
        if (idx) return
        docs = await (await fetch('/search-index.json')).json()
        const { default: FlexSearch } = await import('flexsearch')
        idx = new (FlexSearch as any).Document({
          document: { id: 'slug', index: ['name', 'why', 'review', 'tags'] },
          tokenize: 'forward',
        })
        for (const d of docs) idx.add(d)
      }
      const inp = document.getElementById('search-input') as HTMLInputElement | null
      const out = document.getElementById('search-results')
      inp?.addEventListener('input', async (e) => {
        const q = (e.target as HTMLInputElement).value.trim()
        if (!q) { if (out) out.innerHTML = ''; return }
        await ensureIndex()
        const hits = idx.search(q, { limit: 10, enrich: true })
        const seen = new Set<string>()
        const res: any[] = []
        for (const field of hits) for (const r of field.result) {
          if (seen.has(r.id)) continue
          seen.add(r.id)
          const d = docs.find((x) => x.slug === r.id)
          if (d) res.push(d)
        }
        if (out) out.innerHTML = res.slice(0, 10).map((r) =>
          `<a href="/site/${r.slug}"><div class="sr-name">${r.name}</div><div class="sr-why">${r.why || ''}</div></a>`
        ).join('') || '<div style="padding:0.6rem;color:var(--sepia);">No specimen matches.</div>'
      })

      // notebook: reveal press buttons when signed in; toggle via Clerk island bridge
      window.addEventListener('notebook:sync', (e) => {
        document.body.classList.add('notebook-on')
        const set = new Set((e as CustomEvent).detail as string[])
        document.querySelectorAll<HTMLButtonElement>('.press-btn').forEach((b) => {
          b.setAttribute('aria-pressed', set.has(b.dataset.slug || '') ? 'true' : 'false')
        })
      })
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.press-btn') as HTMLButtonElement | null
        if (!btn) return
        e.preventDefault()
        window.dispatchEvent(new CustomEvent('notebook:press', { detail: btn.dataset.slug }))
      })
    </script>
  </body>
</html>
