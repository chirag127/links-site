---
import BaseLayout from '../layouts/BaseLayout.astro'
import { deadLinks } from '../lib/data'
---

<BaseLayout title="Herbarium of lost links — The Field Ledger" description="Dead specimens from the sdmg15/Best-websites-a-programmer-should-visit archive, pressed and memorialised.">
  <main class="herbarium">
    <h1>Herbarium of lost links.</h1>
    <p class="rip">
      {deadLinks.length} specimens that once featured in
      <a href="https://github.com/sdmg15/Best-websites-a-programmer-should-visit" rel="noopener">sdmg15/Best-websites-a-programmer-should-visit</a>
      but no longer resolve, redirect, or hold their old shape. Pressed here as a record —
      the web forgets fast; a ledger shouldn't.
    </p>
    <ol>
      {deadLinks.map((u) => (
        <li>{u}</li>
      ))}
    </ol>
  </main>
</BaseLayout>
