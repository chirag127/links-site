---
import BaseLayout from '../layouts/BaseLayout.astro'
import CategoryView from '../components/CategoryView.astro'
import ToolFinder from '../components/ToolFinder.tsx'
import { allSites, featured, TIER_LEGEND, categoryList } from '../lib/data'

const total = allSites.length
const plates = categoryList().length
const alive = allSites.filter((s) => s.verified_alive).length
---

<BaseLayout title="The Field Ledger — links.oriz.in">
  <section class="hero-plate" aria-labelledby="ledger-title">
    <svg class="frame" preserveAspectRatio="none" aria-hidden="true">
      <rect class="outer" x="6" y="6" width="calc(100% - 12px)" height="calc(100% - 12px)" />
      <rect class="inner" x="14" y="14" width="calc(100% - 28px)" height="calc(100% - 28px)" />
    </svg>

    <p class="plate-eyebrow">
      <span>Plate 00</span>
      <span class="sep">·</span>
      <span>Genus <span class="genus">developer-web</span></span>
      <span class="sep">·</span>
      <span>Pressed MMXXVI</span>
    </p>

    <h1 class="hero-title" id="ledger-title">The Field <em>Ledger</em>.</h1>

    <p class="hero-thesis">
      Not a link dump. A <strong>catalogue</strong> — every specimen of the developer web
      hand-collected, classified by habitat, tiered by how it lets you in, and
      verified still <strong>alive</strong> in the field this year. Dead specimens
      are kept too, pressed in the herbarium of lost links.
    </p>

    <dl class="hero-meta">
      <div>
        <dt>Specimens catalogued</dt>
        <dd class="num">{total}</dd>
      </div>
      <div>
        <dt>Plates</dt>
        <dd class="num">{plates}</dd>
      </div>
      <div>
        <dt>Verified alive</dt>
        <dd class="num">{alive}</dd>
      </div>
      <div>
        <dt>Field year</dt>
        <dd>2026</dd>
      </div>
    </dl>
  </section>

  <section class="tier-key" aria-label="Tier key">
    {TIER_LEGEND.map((t) => (
      <div class="key-item" data-tier={t.key}>
        <span class="key-glyph">{t.label}</span>
        <div>
          <div class="key-label">{t.label}</div>
          <p class="key-gloss">{t.gloss}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="finder-plate" aria-labelledby="finder-rubric">
    <h2 class="rubric" id="finder-rubric">The Diviner — describe your need, get specimens</h2>
    <p class="finder-lede">
      A field-guide librarian reads your need against the catalogue and points to the
      likeliest plates. Optional; the collection stands without it.
    </p>
    <ToolFinder client:visible />
  </section>

  {featured.length > 0 && (
    <section class="featured" aria-labelledby="featured-rubric">
      <h2 class="rubric" id="featured-rubric">Type specimens — the editor's plates</h2>
      <div class="featured-grid">
        {featured.map((s) => (
          <a class="featured-card" href={`/site/${s.slug}`}>
            <h3 class="fc-name">{s.name}</h3>
            <p class="fc-why">{s.why}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <CategoryView active="agent-era-2026" />
</BaseLayout>
