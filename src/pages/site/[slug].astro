---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { allSites, bySlug, CATEGORY_META, plateNumber, sitesForCategory } from '../../lib/data'

export async function getStaticPaths() {
  return allSites.map((s) => ({ params: { slug: s.slug }, props: { site: s } }))
}

const { site } = Astro.props as { site: (typeof allSites)[number] }
const catLabel = CATEGORY_META[site.category]?.label ?? site.category
const backHref = site.category === 'agent-era-2026' ? '/' : `/${site.category}`
const num = plateNumber(site.category)
const pos = sitesForCategory(site.category).findIndex((s) => s.slug === site.slug) + 1
const specno = `${num} · ${String(pos).padStart(2, '0')}`
---

<BaseLayout title={`${site.name} — The Field Ledger`} description={site.why}>
  <main class="specimen-sheet">
    <div class="breadcrumb">
      <a href={backHref}>Plate {num} — {catLabel}</a> · <span>{site.name}</span>
    </div>

    <p class="sheet-plateno">Specimen {specno}</p>
    <h1 class="detail-title">{site.name}</h1>

    <div class="detail-classline">
      <span class={`tier tier-${site.tier}`}>{site.tier}</span>
      {site.stack_match && <span class="stack-pick">stack pick</span>}
      {site.relevance_to_our_stack === 'high' && <span class="rel-high">high relevance</span>}
    </div>

    <blockquote class="why">{site.why}</blockquote>

    <p class="review-body">{site.review}</p>

    <table class="meta">
      <tbody>
        <tr><td>Habitat</td><td><a href={backHref}>{catLabel}</a></td></tr>
        <tr><td>Access tier</td><td>{site.tier}</td></tr>
        <tr><td>Relevance to stack</td><td>{site.relevance_to_our_stack}</td></tr>
        <tr><td>Last active signal</td><td>{site.last_active_signal}</td></tr>
        <tr><td>Verified alive</td><td>{site.verified_alive ? 'yes — pressed 2026' : 'no'}</td></tr>
        <tr><td>Specimen no.</td><td>{specno}</td></tr>
        <tr>
          <td>Live habitat</td>
          <td><a href={site.url} rel="noopener noreferrer">{site.url}</a></td>
        </tr>
        {site.stack_match && <tr><td>Stack match</td><td>yes</td></tr>}
      </tbody>
    </table>

    <a class="back-link" href={backHref}>← Back to Plate {num}</a>
  </main>
</BaseLayout>
